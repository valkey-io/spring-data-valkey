# Connection Details Factories
org.springframework.boot.autoconfigure.service.connection.ConnectionDetailsFactory=\
io.valkey.springframework.boot.docker.compose.service.connection.valkey.ValkeyDockerComposeConnectionDetailsFactory,\
io.valkey.springframework.boot.testcontainers.service.connection.valkey.ValkeyContainerConnectionDetailsFactory

# Failure Analyzers
org.springframework.boot.diagnostics.FailureAnalyzer=\
io.valkey.springframework.boot.autoconfigure.data.valkey.ValkeyUrlSyntaxFailureAnalyzer

